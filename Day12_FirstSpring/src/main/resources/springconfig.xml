<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans.xsd
         http://www.springframework.org/schema/context
         https://www.springframework.org/schema/context/spring-context.xsd">

    <bean id="hw" class="com.demo.bean.HelloWorld"/>
    <bean id="emp1" class="com.demo.bean.Employee">
    	<property name="eid" value="02"></property>
    	<property name= "ename" value="Aakanksha"></property>
    	<property name="sal" value="1000000"></property>
    </bean> 
    
    <bean id="addr" class="com.demo.bean.Address">
    <property name="street" value="SB road"></property>
    <property name="city" value="Pune"></property>
    <property name="pincode" value="411016"></property>
    
    </bean>
    
    <bean id="usr" class="com.demo.bean.MyUser">
    <property name="uid" value="12"></property>
    <property name="uname" value="Harsh"></property>
    <property name="email" value="harshPatil@gmail.com"></property>
    <property name="addr" ref="addr"></property>
    
    </bean>
</beans>
